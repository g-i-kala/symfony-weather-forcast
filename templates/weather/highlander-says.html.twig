{% extends "base.html.twig" %}
{% block title %}Highlander Says{% endblock %}
{% block body %}
<h1>Highlander says</h1> 
{% for message in app.flashes('info') %}
<p>{{ message }}</p>
{% endfor %}
{% for forecast in forecasts %}
it will be {{ forecast }} <br>
{% endfor %}
{% if threshold %} <p>threshold is {{ threshold }}</p>
{% endif %}


<br><br>
<nav>
  <a href="{{ path('weather_highlander_says', { threshold: 11 }) }}">Try again :)</a>
</nav>
{% endblock %}
{% block javascripts %}
{{ parent() }}
<script>
  const route = "{{ url('weather_highlander_says')|escape('js') }}";
  console.log(route);
</script>
{% endblock %}